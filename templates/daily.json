  "learning": {
    "goal": "fundamentals plus a working understanding, so the reader can use the concept in real discussions with engineers, designers and business stakeholders",
    "tracks": [
      {
        "key": "product",
        "name": "Product",
        "lessons": [
          "Jobs to be Done: what customers actually hire a product for",
          "Problem space vs solution space",
          "Running a good customer interview",
          "North Star metric and input metrics",
          "Metric trees: breaking a goal into levers",
          "Activation and the aha moment",
          "Retention curves and cohort analysis",
          "Funnels and conversion analysis",
          "A/B testing fundamentals",
          "Statistical significance, power and sample size, intuitively",
          "Prioritization frameworks: RICE, ICE, and their limits",
          "Opportunity solution trees",
          "Writing a PRD that engineers actually use",
          "Product-market fit: how to tell if you have it",
          "Pricing models: subscription, usage-based, freemium, take rate",
          "Unit economics: CAC, LTV, payback period, contribution margin",
          "Network effects and their types",
          "Marketplaces: liquidity, supply vs demand side",
          "Growth loops vs funnels",
          "Positioning and differentiation",
          "Go-to-market: PLG vs sales-led",
          "Outcome-based roadmaps",
          "Stakeholder management and saying no",
          "Build vs buy vs partner",
          "Platform strategy and APIs as products",
          "Designing AI products for probabilistic outputs",
          "Evals as the new PRD for AI features",
          "AI product tradeoffs: quality, latency, cost",
          "Trust, safety and risk in fintech products",
          "Experimentation pitfalls: novelty effect, SRM, peeking",
          "Regulated products: compliance as a product constraint",
          "International expansion: localization beyond translation"
        ]
      },
      {
        "key": "tech",
        "name": "Tech",
        "lessons": [
          "What happens when you type a URL: DNS, TCP, TLS, HTTP",
          "APIs and REST: resources, verbs, status codes",
          "SQL vs NoSQL databases",
          "Database indexes: why queries are fast or slow",
          "Transactions and ACID",
          "Caching: where, when, and cache invalidation",
          "Load balancing",
          "Vertical vs horizontal scaling",
          "Queues and async processing",
          "Idempotency and why payments depend on it",
          "Monolith vs microservices",
          "Consistency models and the CAP theorem",
          "Rate limiting",
          "Authentication vs authorization: sessions, OAuth, JWT",
          "Webhooks",
          "CDNs and edge computing",
          "Observability: logs, metrics, traces",
          "CI/CD and feature flags",
          "How card payments work: authorization, clearing, settlement",
          "UPI and real-time payment rails",
          "Ledgers and double-entry bookkeeping in software",
          "Encryption, hashing and tokenization (PCI basics)",
          "Machine learning basics: training vs inference",
          "How LLMs work: tokens and next-token prediction",
          "Transformers and attention, intuitively",
          "Embeddings and vector search",
          "Retrieval-augmented generation (RAG)",
          "Prompting vs fine-tuning vs RAG",
          "AI agents and tool use",
          "Evaluating LLM systems",
          "Context windows, tokens and inference cost",
          "Hallucinations and grounding",
          "Inference optimization: quantization, batching, caching",
          "Model Context Protocol (MCP) and agent integrations"
        ]
      }
    ]
  },
  "challenge_types": [
    "Metrics: define and diagnose (e.g. a metric dropped 15%, what do you check?)",
    "Product sense: design or improve a product for a specific user",
    "Tech / system design: sketch how you would build something, at PM depth",
    "Estimation: a market sizing or back-of-envelope calculation",
    "Fintech case: a payments, lending or banking product decision",
    "Data: write a SQL query or interpret a chart/table described in text",
    "Strategy: a competitive or international market move"
  ]
}
